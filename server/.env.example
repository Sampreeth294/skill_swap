# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB — use a replica set (e.g. MongoDB Atlas) to enable multi-document transactions
MONGODB_URI=mongodb://127.0.0.1:27017/skillswap

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Seed admin account (used by `npm run seed`)
ADMIN_EMAIL=admin@skillswap.dev
ADMIN_PASSWORD=Admin@12345
